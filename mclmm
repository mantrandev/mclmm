#!/usr/bin/env zsh
#
# mclmm — lightweight macOS cleaner CLI (zero dependencies)
#
# Commands:
#   mclmm storage              Disk usage + biggest folders in home
#   mclmm scan                 Smart scan: reclaimable space per category (read-only)
#   mclmm xcode                Clean Xcode DerivedData, project .build (SPM), Archives, Products, sim caches; trim DeviceSupport; erase sim content
#   mclmm cache                Clean user caches, logs, package-manager caches; brew cleanup
#   mclmm clean                Run cache + xcode cleaners
#   mclmm app-list             List installed apps with size
#   mclmm uninstall <app>      Remove an app and all its leftover files
#
# Global flags:
#   --dry-run    Show what would be removed, delete nothing
#   -y, --yes    Skip confirmation prompts
#   --trash      Move to ~/.Trash instead of permanent delete
#   --system     Also touch /Library caches (needs sudo)
#   -h, --help   Show this help

emulate -L zsh
setopt local_options null_glob

VERSION="1.1.0"

DRY_RUN=0
ASSUME_YES=0
USE_TRASH=0
DO_SYSTEM=0

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mclmm"
CONFIG_PATHS_FILE="$CONFIG_DIR/paths.conf"
LAUNCHAGENTS_DIR="$HOME/Library/LaunchAgents"
MCLMM_LOG_DIR="$HOME/Library/Logs/mclmm"
PLIST_PREFIX="com.mclmm"

PROTECTED_PATHS=(
  "$HOME/Library/Caches/org.swift.swiftpm"
)

if [[ -t 1 ]]; then
  C_RESET=$'\e[0m'; C_DIM=$'\e[2m'; C_BOLD=$'\e[1m'
  C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_CYN=$'\e[36m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_RED=""; C_GRN=""; C_YEL=""; C_CYN=""
fi

human() {
  local kb=$1
  if (( kb >= 1048576 )); then
    printf '%.2f GB' $(( kb / 1048576.0 ))
  elif (( kb >= 1024 )); then
    printf '%.2f MB' $(( kb / 1024.0 ))
  else
    printf '%d KB' $kb
  fi
}

size_kb() {
  local p=$1
  [[ -e $p ]] || { print 0; return; }
  du -sk "$p" 2>/dev/null | awk 'END{print ($1==""?0:$1)}'
}

reclaimable_kb() {
  local total=0 p s r skip
  local -a counted
  for p in "$@"; do
    [[ -e $p ]] || continue
    skip=0
    for r in "${counted[@]}"; do
      [[ "$p/" == "$r/"* ]] && { skip=1; break; }
    done
    (( skip )) && continue
    s=$(size_kb "$p")
    counted+=("$p")
    (( total += s ))
  done
  print $total
}

confirm() {
  (( ASSUME_YES )) && return 0
  local reply
  print -n "${C_YEL}$1 [y/N] ${C_RESET}"
  read -r reply
  [[ $reply == [yY] || $reply == [yY][eE][sS] ]]
}

remove_path() {
  local p=$1
  [[ -e $p || -L $p ]] || return 0
  if (( DRY_RUN )); then
    print "  ${C_DIM}would remove${C_RESET} $p"
    return 0
  fi
  if (( USE_TRASH )); then
    local dest="$HOME/.Trash/$(basename "$p").$(date +%s)"
    if mv "$p" "$dest" 2>/dev/null; then
      print "  ${C_GRN}trashed${C_RESET}  $p"
    else
      print "  ${C_RED}failed${C_RESET}   $p"
    fi
  else
    if rm -rf "$p" 2>/dev/null; then
      print "  ${C_GRN}removed${C_RESET}  $p"
    else
      chflags -R nouchg "$p" 2>/dev/null
      if rm -rf "$p" 2>/dev/null; then
        print "  ${C_GRN}removed${C_RESET}  $p"
      else
        print "  ${C_RED}failed${C_RESET}   $p (try with sudo / --trash)"
      fi
    fi
  fi
}

empty_dir() {
  local d=$1 child p
  [[ -d $d ]] || return 0
  for child in "$d"/*(DN); do
    local skip=0
    for p in "${PROTECTED_PATHS[@]}"; do
      [[ "$child" == "$p" ]] && { skip=1; break; }
    done
    if (( skip )); then
      (( DRY_RUN )) && print "  ${C_DIM}keeping${C_RESET}  $child"
      continue
    fi
    remove_path "$child"
  done
}

report_line() {
  if [[ -n ${3:-} ]]; then
    printf "  %-34s %s ${C_DIM}%s${C_RESET}\n" "$1" "$(human $2)" "$3"
  else
    printf '  %-34s %s\n' "$1" "$(human $2)"
  fi
}

# ---------------------------------------------------------------------------

cmd_storage() {
  print "${C_BOLD}Disk${C_RESET}"
  df -H / | awk 'NR==1{printf "  %-18s %6s %6s %6s %8s %s\n",$1,$2,$3,$4,$5,$9} NR==2{printf "  %-18s %6s %6s %6s %8s %s\n",$1,$2,$3,$4,$5,$9}'
  print ""
  print "${C_BOLD}Largest folders in $HOME${C_RESET} ${C_DIM}(top 12)${C_RESET}"
  du -sk "$HOME"/*(DN) 2>/dev/null | sort -rn | head -12 | while read -r kb path; do
    report_line "${path/#$HOME/~}" "$kb"
  done
}

xcode_targets() {
  print -l \
    "$HOME/Library/Developer/Xcode/DerivedData" \
    "$HOME/Library/Developer/Xcode/Archives" \
    "$HOME/Library/Developer/CoreSimulator/Caches" \
    "$HOME/Library/Developer/Xcode/Products"
}

devicesupport_dirs() {
  print -l \
    "$HOME/Library/Developer/Xcode/iOS DeviceSupport" \
    "$HOME/Library/Developer/Xcode/watchOS DeviceSupport" \
    "$HOME/Library/Developer/Xcode/tvOS DeviceSupport"
}

find_project_deriveddata() {
  find "$HOME" \
    \( -path "$HOME/Library" -o -name node_modules -o -name .git -o -path "$HOME/.Trash" \) -prune \
    -o -type d -name DerivedData -print 2>/dev/null
}

find_project_build() {
  find "$HOME" \
    \( -path "$HOME/Library" -o -name node_modules -o -name .git -o -path "$HOME/.Trash" \) -prune \
    -o -type d -name .build -prune -print 2>/dev/null
}

trim_devicesupport() {
  local base=$1 keep=2 i=1 entry
  [[ -d $base ]] || return 0
  local -a entries
  entries=("$base"/*(ND/Om))
  (( ${#entries} <= keep )) && return 0
  print "  ${C_DIM}${base:t}${C_RESET} — keeping ${keep} newest, removing $(( ${#entries} - keep ))"
  for entry in "${entries[@]}"; do
    (( i++ > keep )) && remove_path "$entry"
  done
}

extra_cache_targets() {
  [[ -f $CONFIG_PATHS_FILE ]] || return 0
  local line expanded entry
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line## }"; line="${line%% }"
    [[ -z $line || $line == \#* ]] && continue
    expanded=(${~line}(N))
    for entry in "${expanded[@]}"; do
      print -- "$entry"
    done
  done < "$CONFIG_PATHS_FILE"
}

cache_targets() {
  print -l \
    "$HOME/Library/Caches" \
    "$HOME/Library/Logs" \
    "$HOME/Library/Application Support/CrashReporter" \
    "$HOME/.npm/_cacache" \
    "$HOME/.cache" \
    "$HOME/Library/Caches/Yarn" \
    "$HOME/Library/Caches/pip" \
    "$HOME/Library/Caches/CocoaPods" \
    "$HOME/Library/Caches/Homebrew"
  extra_cache_targets
}

# Checkbox multi-select over PK_LABELS / PK_SIZES; selection returned in PK_SEL.
# Returns 1 if the user cancels with q.
pick_multi() {
  local title=$1
  local n_items=${#PK_LABELS}
  PK_SEL=()
  local i cursor=1 cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  local label_width=$(( cols - 18 ))
  (( label_width < 20 )) && label_width=20
  for (( i=1; i<=n_items; i++ )); do PK_SEL[i]=0; done

  local saved_stty _first=1
  saved_stty=$(stty -g 2>/dev/null)
  stty -echo -icanon min 1 time 0 2>/dev/null
  printf '\e[?25l'

  _render() {
    local sn=0 stotal=0
    for (( i=1; i<=n_items; i++ )); do
      (( PK_SEL[i] )) && { (( sn++ )); (( stotal += PK_SIZES[i] )); }
    done
    if (( _first )); then
      printf '\e[2J\e[H'
      _first=0
    else
      printf '\e[%dA' $(( n_items + 4 ))
    fi
    printf '%s%s%s%s %s\e[K\n' "$C_BOLD" "$C_CYN" "$title" "$C_RESET" \
      "${C_DIM}↑↓ move  SPACE toggle  a all  ENTER confirm  q quit${C_RESET}"
    printf '\e[K\n'
    for (( i=1; i<=n_items; i++ )); do
      local mark="${C_DIM}[ ]${C_RESET}" arrow="  "
      (( PK_SEL[i] )) && mark="${C_GRN}[x]${C_RESET}"
      [[ $i == $cursor ]] && arrow="${C_CYN}▶ ${C_RESET}"
      local lbl="${PK_LABELS[i]}"
      (( ${#lbl} > label_width )) && lbl="…${lbl: -$(( label_width - 1 ))}"
      local sz=""; (( PK_SIZES[i] > 0 )) && sz="$(human ${PK_SIZES[i]})"
      printf '%s%s %-*s %s\e[K\n' "$arrow" "$mark" "$label_width" "$lbl" "$sz"
    done
    printf '\e[K\n  %sSelected:%s %d item(s)' "$C_BOLD" "$C_RESET" "$sn"
    (( stotal > 0 )) && printf ' — %s' "$(human $stotal)"
    printf '\e[K\n'
  }

  local key esc
  while true; do
    _render
    IFS= read -rsk 1 key
    if [[ $key == $'\x1b' ]]; then
      IFS= read -rsk 2 -t 0.05 esc 2>/dev/null || esc=""
      case $esc in
        '[A') (( cursor > 1 )) && (( cursor-- )) ;;
        '[B') (( cursor < n_items )) && (( cursor++ )) ;;
      esac
      continue
    fi
    case $key in
      k) (( cursor > 1 )) && (( cursor-- )) ;;
      j) (( cursor < n_items )) && (( cursor++ )) ;;
      ' ') PK_SEL[cursor]=$(( 1 - PK_SEL[cursor] )) ;;
      a)
        local all_on=1
        for (( i=1; i<=n_items; i++ )); do (( PK_SEL[i] == 0 )) && { all_on=0; break; }; done
        for (( i=1; i<=n_items; i++ )); do PK_SEL[i]=$(( 1 - all_on )); done
        ;;
      $'\n'|$'\r') break ;;
      q|Q)
        stty "$saved_stty" 2>/dev/null; printf '\e[?25h\e[2J\e[H'
        print "${C_DIM}Cancelled.${C_RESET}"; return 1 ;;
    esac
  done

  stty "$saved_stty" 2>/dev/null
  printf '\e[?25h\e[2J\e[H'
  return 0
}

# Drive a checkbox menu from MENU_TITLES / MENU_SIZES; result in MENU_PICK (1/0).
# Non-interactive or -y selects everything. Returns 1 if there are no items or
# the user cancels.
menu_run() {
  local title=$1 i
  (( ${#MENU_TITLES} )) || return 1
  MENU_PICK=()
  if ! [[ -t 0 && -t 1 ]] || (( ASSUME_YES )); then
    for (( i=1; i<=${#MENU_TITLES}; i++ )); do MENU_PICK[i]=1; done
    return 0
  fi
  PK_LABELS=("${MENU_TITLES[@]}"); PK_SIZES=("${MENU_SIZES[@]}")
  pick_multi "$title" || return 1
  MENU_PICK=("${PK_SEL[@]}")
  return 0
}

cmd_scan() {
  print "${C_BOLD}Smart scan${C_RESET} ${C_DIM}(read-only)${C_RESET}"
  local grand=0 kb t r nested
  local -a counted

  account() {
    local p=$1 size=$2
    for r in "${counted[@]}"; do
      if [[ "$p/" == "$r/"* ]]; then
        report_line "${p/#$HOME/~}" "$size" "(within ${r:t})"
        return
      fi
    done
    counted+=("$p"); report_line "${p/#$HOME/~}" "$size"; (( grand += size ))
  }

  print "\n${C_CYN}User caches & logs${C_RESET}"
  for t in $(cache_targets); do
    kb=$(size_kb "$t"); (( kb > 0 )) || continue
    account "$t" "$kb"
  done

  print "\n${C_CYN}Xcode${C_RESET}"
  for t in $(xcode_targets) $(devicesupport_dirs) "$HOME/Library/Developer/CoreSimulator/Devices"; do
    kb=$(size_kb "$t"); (( kb > 0 )) || continue
    account "$t" "$kb"
  done
  for t in ${(f)"$(find_project_deriveddata)"}; do
    kb=$(size_kb "$t"); (( kb > 0 )) || continue
    account "$t" "$kb"
  done

  print "\n${C_CYN}Swift package builds${C_RESET} ${C_DIM}(.build)${C_RESET}"
  for t in ${(f)"$(find_project_build)"}; do
    kb=$(size_kb "$t"); (( kb > 0 )) || continue
    account "$t" "$kb"
  done

  print "\n${C_CYN}Trash${C_RESET}"
  kb=$(size_kb "$HOME/.Trash")
  account "$HOME/.Trash" "$kb"

  if (( DO_SYSTEM )); then
    print "\n${C_CYN}System (sudo)${C_RESET}"
    kb=$(sudo du -sk /Library/Caches 2>/dev/null | awk '{print $1}')
    [[ -n $kb ]] && { report_line "/Library/Caches" "$kb"; (( grand += kb )); }
  fi

  print "\n${C_BOLD}Total reclaimable: ${C_GRN}$(human $grand)${C_RESET}"
  print "${C_DIM}Run 'mclmm clean' to reclaim, or 'mclmm cache' / 'mclmm xcode' selectively.${C_RESET}"
}

cmd_cache() {
  local C="$HOME/Library/Caches"

  local -a browsers pkgs logs others
  browsers=("$C/Google" "$C/BraveSoftware" "$C/Comet" "$C/Firefox"
            "$C/com.apple.Safari" "$C/com.microsoft.edgemac" "$C/company.thebrowser.Browser")
  pkgs=("$HOME/.npm/_cacache" "$C/Yarn" "$C/bun" "$C/pip" "$C/CocoaPods" "$HOME/.cache")
  logs=("$HOME/Library/Logs" "$HOME/Library/Application Support/CrashReporter")

  local d skip r handled
  handled=("${browsers[@]}" "${pkgs[@]}" "${PROTECTED_PATHS[@]}")
  for d in "$C"/*(ND/); do
    skip=0
    for r in "${handled[@]}"; do [[ $d == $r ]] && { skip=1; break; } done
    (( skip )) || others+=("$d")
  done
  others+=($(extra_cache_targets))

  local -a g_titles g_sizes g_arr
  add_group() {
    local title=$1 arrname=$2
    local -a ps; ps=("${(@P)arrname}")
    local tot; tot=$(reclaimable_kb "${ps[@]}")
    (( tot > 0 )) || return 0
    g_titles+=("$title"); g_sizes+=("$tot"); g_arr+=("$arrname")
  }
  clear_group() {
    local -a ps; ps=("${(@P)1}")
    local p; for p in "${ps[@]}"; do empty_dir "$p"; done
  }
  add_group "Browser caches — web assets; keeps history & logins" browsers
  add_group "Package-manager caches — npm/yarn/bun/pip; refetched on install" pkgs
  add_group "App & system logs — diagnostics & crash reports" logs
  add_group "Other app caches — remaining ~/Library/Caches" others

  if (( ${#g_titles} )); then
    local gi
    if ! [[ -t 0 && -t 1 ]] || (( ASSUME_YES )); then
      for (( gi=1; gi<=${#g_titles}; gi++ )); do clear_group "$g_arr[gi]"; done
    else
      PK_LABELS=("${g_titles[@]}"); PK_SIZES=("${g_sizes[@]}")
      if pick_multi "User caches"; then
        local any=0
        for (( gi=1; gi<=${#g_titles}; gi++ )); do
          (( PK_SEL[gi] )) || continue
          any=1
          print "${C_BOLD}Clearing ${g_titles[gi]%% —*} — $(human ${g_sizes[gi]})${C_RESET}"
          clear_group "$g_arr[gi]"
        done
        (( any )) || print "${C_DIM}Nothing selected.${C_RESET}"
      fi
    fi
  fi

  if command -v brew >/dev/null 2>&1 && confirm "Run 'brew cleanup --prune=all' (old downloads & versions)?"; then
    if (( DRY_RUN )); then
      brew cleanup --prune=all -n 2>/dev/null
    else
      brew cleanup --prune=all 2>/dev/null \
        && print "  ${C_GRN}done${C_RESET}     brew cleanup"
    fi
  fi

  local trash_kb
  trash_kb=$(size_kb "$HOME/.Trash")
  if (( trash_kb > 0 )) && confirm "Empty Trash ($(human $trash_kb))?"; then
    empty_dir "$HOME/.Trash"
  fi

  if (( DO_SYSTEM )); then
    if confirm "Clear /Library/Caches with sudo?"; then
      if (( DRY_RUN )); then
        print "  ${C_DIM}would run${C_RESET} sudo rm -rf /Library/Caches/*"
      else
        sudo sh -c 'rm -rf /Library/Caches/* 2>/dev/null' \
          && print "  ${C_GRN}removed${C_RESET}  /Library/Caches/*"
      fi
    fi
  fi
}

select_deriveddata() {
  local dd="$HOME/Library/Developer/Xcode/DerivedData"

  local -a paths labels sizes
  local dir kb wspath label

  if [[ -d $dd ]]; then
    for dir in "$dd"/*(ND/); do
      kb=$(size_kb "$dir")
      (( kb > 0 )) || continue
      paths+=("$dir"); sizes+=("$kb")
      if [[ -f "$dir/info.plist" ]]; then
        wspath=$(/usr/libexec/PlistBuddy -c "Print WorkspacePath" "$dir/info.plist" 2>/dev/null)
      else
        wspath=""
      fi
      label="${wspath:+${wspath/#$HOME/~}}"
      [[ -z $label ]] && label="${dir:t}"
      labels+=("$label")
    done
  fi

  print "${C_DIM}Scanning home for custom DerivedData…${C_RESET}"
  for dir in ${(f)"$(find_project_deriveddata)"}; do
    kb=$(size_kb "$dir")
    (( kb > 0 )) || continue
    paths+=("$dir"); sizes+=("$kb")
    labels+=("${dir/#$HOME/~}")
  done

  (( ${#paths} == 0 )) && { print "${C_DIM}No DerivedData found.${C_RESET}"; return 0; }

  if ! [[ -t 0 && -t 1 ]] || (( ASSUME_YES )); then
    for dir in "${paths[@]}"; do remove_path "$dir"; done
    return 0
  fi

  PK_LABELS=("${labels[@]}"); PK_SIZES=("${sizes[@]}")
  pick_multi "DerivedData" || return 0

  local i n=0 total_kb=0
  for (( i=1; i<=${#paths}; i++ )); do
    (( PK_SEL[i] )) && { (( n++ )); (( total_kb += sizes[i] )); }
  done

  if (( n == 0 )); then print "${C_DIM}Nothing selected.${C_RESET}"; return 0; fi

  print "${C_BOLD}Removing ${n} item(s) — $(human $total_kb)${C_RESET}"
  for (( i=1; i<=${#paths}; i++ )); do
    (( PK_SEL[i] )) && remove_path "${paths[i]}"
  done
}

cmd_xcode() {
  command -v xcrun >/dev/null 2>&1 || { print "${C_RED}Xcode tools not found.${C_RESET}"; return 1; }

  if pgrep -x Xcode >/dev/null 2>&1; then
    print "${C_YEL}Xcode is running — quitting before cleanup.${C_RESET}"
    (( DRY_RUN )) || osascript -e 'tell application "Xcode" to quit' 2>/dev/null
    (( DRY_RUN )) || sleep 2
  fi

  select_deriveddata

  print "${C_DIM}Scanning home for Swift package builds (.build)…${C_RESET}"
  local -a build_dirs
  build_dirs=(${(f)"$(find_project_build)"})
  if (( ${#build_dirs} )); then
    local build_total
    build_total=$(reclaimable_kb "${build_dirs[@]}")
    if confirm "Remove ${#build_dirs} Swift package .build dirs ($(human $build_total))? Rebuilds on next build."; then
      local b
      for b in "${build_dirs[@]}"; do remove_path "$b"; done
    fi
  fi

  local others=("$HOME/Library/Developer/Xcode/Archives"
                 "$HOME/Library/Developer/CoreSimulator/Caches"
                 "$HOME/Library/Developer/Xcode/Products")
  local others_total
  others_total=$(reclaimable_kb "${others[@]}")
  if confirm "Clear Archives, Products and sim caches ($(human $others_total))?"; then
    local t
    for t in "${others[@]}"; do empty_dir "$t"; done
  fi

  local ds_dirs
  ds_dirs=($(devicesupport_dirs))
  if confirm "Trim DeviceSupport — keep 2 newest per platform, delete the rest?"; then
    local d
    for d in "${ds_dirs[@]}"; do trim_devicesupport "$d"; done
  fi

  if confirm "Delete unavailable simulators?"; then
    if (( DRY_RUN )); then
      print "  ${C_DIM}would run${C_RESET} xcrun simctl delete unavailable"
    else
      xcrun simctl delete unavailable 2>/dev/null \
        && print "  ${C_GRN}done${C_RESET}     removed unavailable simulators"
    fi
  fi

  local sim_devices="$HOME/Library/Developer/CoreSimulator/Devices"
  if [[ -d $sim_devices ]]; then
    local sim_kb
    sim_kb=$(size_kb "$sim_devices")
    if [[ -t 0 && -t 1 ]] && (( sim_kb > 0 )) && confirm "Erase ALL simulator content & data ($(human $sim_kb))? Keeps devices, wipes installed apps."; then
      if (( DRY_RUN )); then
        print "  ${C_DIM}would run${C_RESET} xcrun simctl shutdown all && xcrun simctl erase all"
      else
        xcrun simctl shutdown all 2>/dev/null
        xcrun simctl erase all 2>/dev/null \
          && print "  ${C_GRN}done${C_RESET}     erased all simulator content"
      fi
    fi
  fi
}

cmd_uninstall() {
  local app=$1
  [[ -n $app ]] || { print "${C_RED}Usage: mclmm uninstall <AppName | /path/App.app>${C_RESET}"; return 1; }

  local apppath=""
  if [[ -d $app && $app == *.app ]]; then
    apppath=$app
  elif [[ -d "/Applications/$app.app" ]]; then
    apppath="/Applications/$app.app"
  elif [[ -d "/Applications/$app" ]]; then
    apppath="/Applications/$app"
  elif [[ -d "$HOME/Applications/$app.app" ]]; then
    apppath="$HOME/Applications/$app.app"
  fi

  if [[ -z $apppath ]]; then
    print "${C_RED}App not found:${C_RESET} $app"
    print "${C_DIM}Pass the name (without .app) or a full path to the .app bundle.${C_RESET}"
    return 1
  fi

  local appname="${apppath:t:r}"
  local bid
  bid=$(defaults read "$apppath/Contents/Info" CFBundleIdentifier 2>/dev/null)
  print "${C_BOLD}Uninstall:${C_RESET} $appname"
  print "  bundle: ${bid:-unknown}"
  print "  app:    $apppath"

  local -a candidates
  candidates=("$apppath")
  candidates+=(
    "$HOME/Library/Application Support/$appname"
    "$HOME/Library/Caches/$appname"
    "$HOME/Library/Logs/$appname"
    "$HOME/Library/Preferences/$appname.plist"
  )
  if [[ -n $bid ]]; then
    candidates+=(
      "$HOME/Library/Application Support/$bid"
      "$HOME/Library/Caches/$bid"
      "$HOME/Library/Preferences/$bid.plist"
      "$HOME/Library/Preferences/$bid".*.plist
      "$HOME/Library/Saved Application State/$bid.savedState"
      "$HOME/Library/Containers/$bid"
      "$HOME/Library/Application Scripts/$bid"
      "$HOME/Library/HTTPStorages/$bid"
      "$HOME/Library/HTTPStorages/$bid".*
      "$HOME/Library/WebKit/$bid"
      "$HOME/Library/Cookies/$bid.binarycookies"
      "$HOME/Library/LaunchAgents/$bid.plist"
      $HOME/Library/Group\ Containers/*"$bid"*
    )
  fi

  local -a found
  local c kb total=0
  for c in "${candidates[@]}"; do
    [[ -e $c || -L $c ]] || continue
    kb=$(size_kb "$c")
    found+=("$c")
    report_line "${c/#$HOME/~}" "$kb"
    (( total += kb ))
  done

  (( ${#found} == 0 )) && { print "${C_DIM}Nothing to remove.${C_RESET}"; return 0; }
  print "${C_BOLD}Total: $(human $total) across ${#found} items${C_RESET}"

  if [[ -n $appname ]] && pgrep -x "$appname" >/dev/null 2>&1; then
    print "${C_YEL}$appname is running — quitting it first.${C_RESET}"
    (( DRY_RUN )) || osascript -e "tell application \"$appname\" to quit" 2>/dev/null
  fi

  if confirm "Permanently remove all ${#found} items above?"; then
    for c in "${found[@]}"; do remove_path "$c"; done
  fi
}

cmd_clean() {
  cmd_cache
  print ""
  cmd_xcode
}

cmd_config() {
  local action=${1:-list} path=${2:-}
  case $action in
    list)
      print "${C_BOLD}Extra cache paths${C_RESET} ${C_DIM}($CONFIG_PATHS_FILE)${C_RESET}"
      if [[ ! -f $CONFIG_PATHS_FILE ]]; then
        print "  ${C_DIM}(none configured)${C_RESET}"
        return 0
      fi
      local line i=1
      while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        printf '  %2d  %s\n' "$i" "$line"
        (( i++ ))
      done < "$CONFIG_PATHS_FILE"
      ;;
    add)
      [[ -n $path ]] || { print "${C_RED}Usage: mclmm config add <path-or-glob>${C_RESET}"; return 1; }
      mkdir -p "$CONFIG_DIR"
      touch "$CONFIG_PATHS_FILE"
      if grep -Fxq -- "$path" "$CONFIG_PATHS_FILE" 2>/dev/null; then
        print "${C_DIM}already present:${C_RESET} $path"
      else
        print -- "$path" >> "$CONFIG_PATHS_FILE"
        print "${C_GRN}added${C_RESET}    $path"
      fi
      ;;
    remove|rm)
      [[ -n $path ]] || { print "${C_RED}Usage: mclmm config remove <path-or-glob>${C_RESET}"; return 1; }
      [[ -f $CONFIG_PATHS_FILE ]] || { print "${C_DIM}nothing to remove${C_RESET}"; return 0; }
      local tmp="$CONFIG_PATHS_FILE.tmp"
      grep -Fxv -- "$path" "$CONFIG_PATHS_FILE" > "$tmp" 2>/dev/null || true
      mv "$tmp" "$CONFIG_PATHS_FILE"
      print "${C_GRN}removed${C_RESET}  $path"
      ;;
    *)
      print "${C_RED}Unknown config action:${C_RESET} $action"
      print "  mclmm config list"
      print "  mclmm config add <path-or-glob>"
      print "  mclmm config remove <path-or-glob>"
      return 1
      ;;
  esac
}

script_realpath() {
  local p=$1
  if command -v realpath >/dev/null 2>&1; then
    realpath "$p" 2>/dev/null && return
  fi
  if command -v readlink >/dev/null 2>&1; then
    readlink -f "$p" 2>/dev/null && return
  fi
  print -- "$p"
}

schedule_pick() {
  local prompt=$1; shift
  local -a opts=("$@")
  local i reply
  {
    print "${C_BOLD}$prompt${C_RESET}"
    for (( i=1; i<=${#opts}; i++ )); do
      printf '  %d) %s\n' "$i" "${opts[i]}"
    done
    print -n "${C_YEL}Choose [1-${#opts}, default 1]: ${C_RESET}"
  } >&2
  read -r reply
  [[ -z $reply ]] && reply=1
  if ! [[ $reply == <-> ]] || (( reply < 1 || reply > ${#opts} )); then
    print "${C_RED}Invalid choice.${C_RESET}" >&2
    return 1
  fi
  print -- "${opts[reply]}"
}

schedule_pick_hour() {
  local reply
  print -n "${C_YEL}Hour 0-23 [default 3]: ${C_RESET}" >&2
  read -r reply
  [[ -z $reply ]] && reply=3
  if ! [[ $reply == <-> ]] || (( reply < 0 || reply > 23 )); then
    print "${C_RED}Invalid hour.${C_RESET}" >&2
    return 1
  fi
  print -- "$reply"
}

schedule_install() {
  local task=$1 freq=$2 weekday=$3 hour=$4
  local script
  script=$(script_realpath "$0")
  if [[ ! -x $script ]]; then
    print "${C_RED}Cannot resolve script path:${C_RESET} $script"
    return 1
  fi

  mkdir -p "$LAUNCHAGENTS_DIR" "$MCLMM_LOG_DIR"
  local label="$PLIST_PREFIX.$task"
  local plist="$LAUNCHAGENTS_DIR/$label.plist"
  local log="$MCLMM_LOG_DIR/$task.log"

  local cal_block
  if [[ $freq == weekly ]]; then
    cal_block="    <key>Weekday</key><integer>$weekday</integer>
    <key>Hour</key><integer>$hour</integer>
    <key>Minute</key><integer>0</integer>"
  else
    cal_block="    <key>Hour</key><integer>$hour</integer>
    <key>Minute</key><integer>0</integer>"
  fi

  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$script</string>
    <string>$task</string>
    <string>-y</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
$cal_block
  </dict>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
EOF

  launchctl unload "$plist" 2>/dev/null
  if launchctl load "$plist" 2>/dev/null; then
    print "${C_GRN}✓ installed${C_RESET} $label"
    print "  plist: $plist"
    print "  log:   $log"
  else
    print "${C_RED}launchctl load failed${C_RESET} — plist written but not loaded"
    return 1
  fi
}

schedule_list_jobs() {
  local -a plists
  plists=("$LAUNCHAGENTS_DIR/$PLIST_PREFIX".*.plist(N))
  if (( ${#plists} == 0 )); then
    print "${C_DIM}(no mclmm schedules)${C_RESET}"
    return 0
  fi
  local p label loaded
  print "${C_BOLD}mclmm schedules${C_RESET}"
  for p in "${plists[@]}"; do
    label=${p:t:r}
    if launchctl list 2>/dev/null | awk '{print $3}' | grep -Fxq "$label"; then
      loaded="${C_GRN}loaded${C_RESET}"
    else
      loaded="${C_DIM}not loaded${C_RESET}"
    fi
    printf '  %-30s %s\n' "$label" "$loaded"
    printf '    %s%s%s\n' "$C_DIM" "$p" "$C_RESET"
  done
}

schedule_remove() {
  local -a plists
  plists=("$LAUNCHAGENTS_DIR/$PLIST_PREFIX".*.plist(N))
  if (( ${#plists} == 0 )); then
    print "${C_DIM}(no mclmm schedules to remove)${C_RESET}"
    return 0
  fi

  if ! [[ -t 0 && -t 1 ]]; then
    local i p reply
    print "${C_BOLD}Remove which schedule?${C_RESET}"
    for (( i=1; i<=${#plists}; i++ )); do
      printf '  %d) %s\n' "$i" "${plists[i]:t:r}"
    done
    print -n "${C_YEL}Choose [1-${#plists}, or 'a' for all]: ${C_RESET}"
    read -r reply
    local -a victims
    if [[ $reply == a || $reply == A ]]; then
      victims=("${plists[@]}")
    elif [[ $reply == <-> ]] && (( reply >= 1 && reply <= ${#plists} )); then
      victims=("${plists[reply]}")
    else
      print "${C_DIM}cancelled${C_RESET}"
      return 0
    fi
    for p in "${victims[@]}"; do
      launchctl unload "$p" 2>/dev/null
      rm -f "$p"
      print "${C_GRN}removed${C_RESET}  ${p:t:r}"
    done
    return 0
  fi

  local cursor=1 first=1 saved_stty key esc i
  local -a sel
  for (( i=1; i<=${#plists}; i++ )); do sel[i]=0; done
  saved_stty=$(stty -g 2>/dev/null)
  stty -echo -icanon min 1 time 0 2>/dev/null
  printf '\e[?25l'

  _render_rm() {
    if (( first )); then
      printf '\e[2J\e[H'
      first=0
    else
      printf '\e[%dA' $(( ${#plists} + 4 ))
    fi
    printf '%sRemove mclmm schedule%s %s↑↓ move  SPACE toggle  a all  ENTER confirm  ESC/q cancel%s\e[K\n' \
      "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '\e[K\n'
    local i mark arrow
    for (( i=1; i<=${#plists}; i++ )); do
      mark="${C_DIM}[ ]${C_RESET}"; arrow="  "
      (( sel[i] )) && mark="${C_GRN}[x]${C_RESET}"
      [[ $i == $cursor ]] && arrow="${C_CYN}▶ ${C_RESET}"
      printf '%s%s %s\e[K\n' "$arrow" "$mark" "${plists[i]:t:r}"
    done
    local n=0
    for (( i=1; i<=${#plists}; i++ )); do (( sel[i] )) && (( n++ )); done
    printf '\e[K\n  %sSelected:%s %d item(s)\e[K\n' "$C_BOLD" "$C_RESET" "$n"
  }

  while true; do
    _render_rm
    IFS= read -rsk 1 key
    if [[ $key == $'\x1b' ]]; then
      IFS= read -rsk 2 -t 0.05 esc 2>/dev/null || esc=""
      case $esc in
        '[A') (( cursor > 1 )) && (( cursor-- )) ;;
        '[B') (( cursor < ${#plists} )) && (( cursor++ )) ;;
        '')
          stty "$saved_stty" 2>/dev/null
          printf '\e[?25h\e[2J\e[H'
          print "${C_DIM}cancelled${C_RESET}"
          return 0
          ;;
      esac
      continue
    fi
    case $key in
      k) (( cursor > 1 )) && (( cursor-- )) ;;
      j) (( cursor < ${#plists} )) && (( cursor++ )) ;;
      ' ') sel[cursor]=$(( 1 - sel[cursor] )) ;;
      a|A)
        local all_on=1
        for (( i=1; i<=${#plists}; i++ )); do (( sel[i] == 0 )) && { all_on=0; break; }; done
        for (( i=1; i<=${#plists}; i++ )); do sel[i]=$(( 1 - all_on )); done
        ;;
      $'\n'|$'\r') break ;;
      q|Q)
        stty "$saved_stty" 2>/dev/null
        printf '\e[?25h\e[2J\e[H'
        print "${C_DIM}cancelled${C_RESET}"
        return 0
        ;;
    esac
  done

  stty "$saved_stty" 2>/dev/null
  printf '\e[?25h\e[2J\e[H'

  local n=0
  for (( i=1; i<=${#plists}; i++ )); do (( sel[i] )) && (( n++ )); done
  if (( n == 0 )); then
    print "${C_DIM}Nothing selected.${C_RESET}"
    return 0
  fi

  local p
  for (( i=1; i<=${#plists}; i++ )); do
    (( sel[i] )) || continue
    p=${plists[i]}
    launchctl unload "$p" 2>/dev/null
    rm -f "$p"
    print "${C_GRN}removed${C_RESET}  ${p:t:r}"
  done
}

schedule_form() {
  local -a tasks=(clean cache xcode)
  local -a freqs=(weekly daily)
  local -a days=(Sun Mon Tue Wed Thu Fri Sat)
  local task_idx=1 freq_idx=1 day_idx=1 hour=3
  local -a fields
  local cursor=1 first=1 saved_stty key esc
  saved_stty=$(stty -g 2>/dev/null)
  stty -echo -icanon min 1 time 0 2>/dev/null
  printf '\e[?25l'

  local _last_rows=0
  _refresh_fields() {
    if [[ ${freqs[freq_idx]} == weekly ]]; then
      fields=(task freq day hour)
    else
      fields=(task freq hour)
    fi
    (( cursor > ${#fields} )) && cursor=${#fields}
  }

  _draw_row() {
    local label=$1 value=$2 is_cursor=$3
    local mark="  " left="${C_DIM}◀${C_RESET}" right="${C_DIM}▶${C_RESET}"
    (( is_cursor )) && { mark="${C_CYN}▶ ${C_RESET}"; left="${C_GRN}◀${C_RESET}"; right="${C_GRN}▶${C_RESET}"; }
    printf '%s%-12s %s %s%-8s%s %s\e[K\n' "$mark" "$label" "$left" "$C_BOLD" "$value" "$C_RESET" "$right"
  }

  _render() {
    _refresh_fields
    local total=$(( ${#fields} + 4 ))
    if (( first )); then
      printf '\e[2J\e[H'
      first=0
    else
      printf '\e[%dA' "$_last_rows"
    fi
    _last_rows=$total
    printf '%sSchedule mclmm cleanup%s\e[K\n' "$C_BOLD" "$C_RESET"
    printf '\e[K\n'
    local i field
    for (( i=1; i<=${#fields}; i++ )); do
      field=${fields[i]}
      case $field in
        task) _draw_row "Task"      "${tasks[task_idx]}"            "$(( i == cursor ))" ;;
        freq) _draw_row "Frequency" "${freqs[freq_idx]}"            "$(( i == cursor ))" ;;
        day)  _draw_row "Day"       "${days[day_idx]}"              "$(( i == cursor ))" ;;
        hour) _draw_row "Hour"      "$(printf '%02d:00' $hour)"     "$(( i == cursor ))" ;;
      esac
    done
    printf '\e[K\n'
    printf '  %s↑↓%s field  %s←→%s value  %sENTER%s install  %sESC/q%s cancel\e[K\n' \
      "$C_DIM" "$C_RESET" "$C_DIM" "$C_RESET" "$C_DIM" "$C_RESET" "$C_DIM" "$C_RESET"
  }

  _adjust() {
    local dir=$1 field=${fields[cursor]}
    case $field in
      task) task_idx=$(( (task_idx - 1 + dir + ${#tasks}) % ${#tasks} + 1 )) ;;
      freq) freq_idx=$(( (freq_idx - 1 + dir + ${#freqs}) % ${#freqs} + 1 )) ;;
      day)  day_idx=$(( (day_idx  - 1 + dir + ${#days})  % ${#days}  + 1 )) ;;
      hour) hour=$(( (hour + dir + 24) % 24 )) ;;
    esac
  }

  while true; do
    _render
    IFS= read -rsk 1 key
    if [[ $key == $'\x1b' ]]; then
      IFS= read -rsk 2 -t 0.05 esc 2>/dev/null || esc=""
      case $esc in
        '[A') (( cursor > 1 )) && (( cursor-- )) ;;
        '[B') (( cursor < ${#fields} )) && (( cursor++ )) ;;
        '[C') _adjust 1 ;;
        '[D') _adjust -1 ;;
        '')
          stty "$saved_stty" 2>/dev/null
          printf '\e[?25h\e[2J\e[H'
          print "${C_DIM}Cancelled.${C_RESET}"
          return 1
          ;;
      esac
      continue
    fi
    case $key in
      $'\n'|$'\r') break ;;
      h) _adjust -1 ;;
      l) _adjust 1 ;;
      k) (( cursor > 1 )) && (( cursor-- )) ;;
      j) (( cursor < ${#fields} )) && (( cursor++ )) ;;
      q|Q)
        stty "$saved_stty" 2>/dev/null
        printf '\e[?25h\e[2J\e[H'
        print "${C_DIM}Cancelled.${C_RESET}"
        return 1
        ;;
    esac
  done

  stty "$saved_stty" 2>/dev/null
  printf '\e[?25h\e[2J\e[H'

  _SCHED_TASK=${tasks[task_idx]}
  _SCHED_FREQ=${freqs[freq_idx]}
  _SCHED_DAY_NAME=${days[day_idx]}
  _SCHED_WEEKDAY=$(( day_idx - 1 ))
  _SCHED_HOUR=$hour
  return 0
}

cmd_schedule() {
  local sub=${1:-}
  case $sub in
    list) schedule_list_jobs ;;
    remove|rm) schedule_remove ;;
    ""|add)
      local task freq weekday=0 hour day_name
      if [[ -t 0 && -t 1 ]]; then
        schedule_form || return 1
        task=$_SCHED_TASK
        freq=$_SCHED_FREQ
        weekday=$_SCHED_WEEKDAY
        day_name=$_SCHED_DAY_NAME
        hour=$_SCHED_HOUR
      else
        task=$(schedule_pick "Task" clean cache xcode) || return 1
        freq=$(schedule_pick "Frequency" weekly daily) || return 1
        if [[ $freq == weekly ]]; then
          day_name=$(schedule_pick "Day of week" Sun Mon Tue Wed Thu Fri Sat) || return 1
          case $day_name in
            Sun) weekday=0 ;; Mon) weekday=1 ;; Tue) weekday=2 ;;
            Wed) weekday=3 ;; Thu) weekday=4 ;; Fri) weekday=5 ;; Sat) weekday=6 ;;
          esac
        fi
        hour=$(schedule_pick_hour) || return 1
      fi
      print "${C_BOLD}Summary${C_RESET}"
      print "  task:      $task"
      print "  frequency: $freq"
      [[ $freq == weekly ]] && print "  day:       $day_name"
      print "  hour:      $(printf '%02d:00' "$hour")"
      if confirm "Install schedule?"; then
        schedule_install "$task" "$freq" "$weekday" "$hour"
      else
        print "${C_DIM}cancelled${C_RESET}"
      fi
      ;;
    *)
      print "${C_RED}Unknown schedule action:${C_RESET} $sub"
      print "  mclmm schedule          # interactive add"
      print "  mclmm schedule list"
      print "  mclmm schedule remove"
      return 1
      ;;
  esac
}

cmd_app_list() {
  local dir app kb
  local -a rows
  print "${C_BOLD}Installed apps${C_RESET} ${C_DIM}(/Applications)${C_RESET}"
  for dir in /Applications/*.app(N); do
    app=${dir:t:r}
    kb=$(size_kb "$dir")
    (( kb > 0 )) || continue
    rows+=("$kb $app")
  done
  printf '%s\n' "${rows[@]}" | sort -rn | while read -r kb app; do
    report_line "$app" "$kb"
  done
}

usage() {
  print "${C_BOLD}mclmm${C_RESET} v$VERSION — lightweight macOS cleaner"
  print ""
  print "  mclmm storage              Disk usage + biggest folders in home"
  print "  mclmm scan                 Reclaimable space per category (read-only)"
  print "  mclmm xcode                Clean DerivedData, .build, Archives, DeviceSupport, sims"
  print "  mclmm cache                Clean caches, logs, pkg-manager caches, brew, Trash"
  print "  mclmm clean                cache + xcode"
  print "  mclmm app-list             List installed apps with size"
  print "  mclmm uninstall <app>      Remove an app and all its leftovers"
  print "  mclmm config [add|remove|list] <path>"
  print "                             Manage extra cache paths (globs supported)"
  print "  mclmm schedule [list|remove]"
  print "                             Install a launchd job to run a cleanup periodically"
  print ""
  print "  Each subcommand is also callable prefixed: ${C_DIM}mclmm-clean, mclmm-scan, …${C_RESET}"
  print "  Flags: --dry-run  -y/--yes  --trash  --system  -h/--help"
}

# ---------------------------------------------------------------------------

main() {
  local -a args
  while (( $# )); do
    case $1 in
      --dry-run) DRY_RUN=1 ;;
      -y|--yes)  ASSUME_YES=1 ;;
      --trash)   USE_TRASH=1 ;;
      --system)  DO_SYSTEM=1 ;;
      -h|--help) usage; return 0 ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  local cmd=${args[1]:-}
  case $cmd in
    storage)   cmd_storage ;;
    scan)      cmd_scan ;;
    xcode)     cmd_xcode ;;
    cache)     cmd_cache ;;
    clean)     cmd_clean ;;
    app-list)  cmd_app_list ;;
    uninstall) cmd_uninstall "${args[2]:-}" ;;
    config)    cmd_config "${args[2]:-}" "${args[3]:-}" ;;
    schedule)  cmd_schedule "${args[2]:-}" ;;
    ""|help)   usage ;;
    *) print "${C_RED}Unknown command: $cmd${C_RESET}"; usage; return 1 ;;
  esac
}

_argv0=${0:t}
if [[ $_argv0 == mclmm-?* ]]; then
  main "${_argv0#mclmm-}" "$@"
else
  main "$@"
fi
